// .env.example – copy this file to .env and replace placeholder values with your own
// This file uses CommonJS syntax so it can be required in Node.js projects

module.exports = {
  // Discord bot token (required)
  DISCORD_TOKEN: 'YOUR_DISCORD_TOKEN_HERE',

  // Discord application (client) ID (optional, but useful for OAuth2 URLs)
  DISCORD_CLIENT_ID: 'YOUR_CLIENT_ID_HERE',

  // Discord guild (server) ID for testing commands (optional)
  DISCORD_GUILD_ID: 'YOUR_GUILD_ID_HERE',

  // Database connection string (e.g., PostgreSQL, MySQL, SQLite)
  DATABASE_URL: 'postgres://user:password@localhost:5432/database_name',

  // Port on which the bot's web server (if any) should listen
  PORT: 3000,

  // Enable verbose logging (true or false)
  DEBUG: false,

  // Prefix for legacy command handling (if you support message commands)
  COMMAND_PREFIX: '!',

  // API key for external services (replace with actual service name)
  EXTERNAL_API_KEY: 'YOUR_API_KEY_HERE',
};